# Local dev: leave empty to use the Vite proxy (no CORS issues).
# Production (Vercel → Settings → Environment Variables):
# VITE_API_URL=https://shotbyvorserver.vercel.app
VITE_API_URL=

# Your Cloudinary cloud name (found in Cloudinary dashboard → top-left).
# Used by the admin panel to upload videos directly to Cloudinary from the
# browser, bypassing the server and its 4.5 MB Vercel body limit.
# Example: VITE_CLOUDINARY_CLOUD_NAME=mycloud
VITE_CLOUDINARY_CLOUD_NAME=
