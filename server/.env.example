# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/shotbyvor

# Cloudinary — paste the full URL from your Cloudinary dashboard
# Found at: https://console.cloudinary.com → Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Master API key — choose any strong secret string
ADMIN_API_KEY=your_super_secret_key_here

# Browser origin(s) allowed to call this API (CORS). Local dev already allows
# http://localhost:3000 — set this to your deployed client URL, e.g.
# CLIENT_URL=https://shotbyvor.vercel.app
# Multiple origins: comma-separated, no spaces.
CLIENT_URL=

# Server port
PORT=5000
