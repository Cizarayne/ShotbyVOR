# ── ShotbyVOR — never push these to GitHub ───────────────────────────────────

# Secrets & environment (MONGO_URI, CLOUDINARY_URL, ADMIN_API_KEY live here)
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies (reinstalled with `npm install`)
node_modules/
client/node_modules/
server/node_modules/

# Build output (regenerated with `npm run build`)
dist/
build/
client/dist/
client/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor clutter
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local uploads & temp files (user content / scratch, not source code)
uploads/
tmp/
temp/
*.tmp
